# Credentials template for homelab discovery script.
# Copy to credentials.yaml and fill in real values.
# This file should be git-ignored and encrypted with SOPS.

# ============================================================
# OPNsense
# ============================================================
opnsense:
  api_url: "https://fw.nf.lab/api/json-rpc.php"
  api_key: "your_opnsense_api_key_here"    # generated in OPNsense → System → Access → API
  api_secret: "your_opnsense_api_secret_here"

# ============================================================
# Brocade Switches
# ============================================================
switches:
  - name: "Brocade1"
    model: "Brocade ICX 6610"
    ssh_host: "10.0.99.2"
    ssh_user: "admin"
    ssh_password: "your_switch_password_here"  # or use SSH key
    # OR use API token if supported
    # api_token: "brocade_api_token"

  - name: "Brocade2"
    model: "Brocade ICX 6450"
    ssh_host: "10.0.99.3"
    ssh_user: "admin"
    ssh_password: "your_switch_password_here"

# ============================================================
# OpenWrt Access Points
# ============================================================
access_points:
  - name: "OpenWrt-AP-1"
    model: "OpenWrt x86_64"
    ssh_host: "10.0.10.1"
    ssh_user: "discovery"     # Use dedicated discovery user (not root)
    # SSH key authentication (supports both RSA and ed25519):
    #   - ed25519: ~/.ssh/id_ed25519   (newer, preferred)
    #   - RSA:    ~/.ssh/id_rsa         (older compatibility)
    ssh_key_path: "~/.ssh/id_rsa"  # Change to id_ed25519 for ed25519 key"
    # Password auth is disabled; key-only authentication required"
    # SNMP fallback (optional):"
    # snmp_community: "private"  # Custom community string (not "public")"
    # snmp_host: "10.0.10.1"   # Override default SNMP host"

  - name: "OpenWrt-AP-2"
    model: "OpenWrt x86_64"
    ssh_host: "10.0.40.1"
    ssh_user: "discovery"     # Use dedicated discovery user (not root)
    # SSH key authentication (supports both RSA and ed25519):
    #   - ed25519: ~/.ssh/id_ed25519   (newer, preferred)
    #   - RSA:    ~/.ssh/id_rsa         (older compatibility)
    ssh_key_path: "~/.ssh/id_rsa"  # Change to id_ed25519 for ed25519 key"
    # Password auth is disabled; key-only authentication required"
    # SNMP fallback (optional):"
    # snmp_community: "private"  # Custom community string (not "public")"
    # snmp_host: "10.0.40.1"   # Override default SNMP host"

# ============================================================
# Proxmox / PVE hosts
# ============================================================
proxmox:
  - name: "virt01"
    model: "Proxmox VE Server"
    api_url: "https://virt01.example.com:8006/api2/json"
    api_user: "root@pam"
    api_key: "your_proxmox_api_key"    # generated in PVE → ACME → SSH Keys
    api_secret: "your_proxmox_api_secret"

# ============================================================
# Linux servers and services (K8s, PowerDNS, Harbor, etc.)
# ============================================================
linux:
  - name: "virt01"
    model: "Custom Linux Server"
    ssh_host: "10.0.10.50"
    ssh_user: "discovery"
    ssh_key_path: "~/.ssh/id_rsa"  # or id_ed25519
    # Services running on this server
    services:
      - {name: "Kubernetes", port: "6443", proto: "TCP", note: "k8s cluster API"}
      - {name: "Harbor", port: "80, 443", proto: "TCP/UDP", note: "container registry"}
      - {name: "PowerDNS", port: "53", proto: "UDP", note: "DNS server"}
      - {name: "Jellyfin", port: "8096", proto: "TCP", note: "media streaming"}
      - {name: "Portainer", port: "9000", proto: "TCP", note: "k8s dashboard"}

  - name: "ns1"
    model: "Linux server (PowerDNS + Harbor)"
    ssh_host: "10.0.40.50"
    ssh_user: "discovery"
    ssh_key_path: "~/.ssh/id_rsa"
    # Services running on this server
    services:
      - {name: "PowerDNS", port: "53", proto: "UDP", note: "authoritative DNS"}
      - {name: "PowerDNS API", port: "8081", proto: "TCP", note: "API endpoint"}
      - {name: "Harbor Docker Compose", port: "80, 443", proto: "TCP/UDP", note: "container registry UI/API"}
      - {name: "Cert-Manager", port: "8080", proto: "TCP", note: "TLS certificate management"}
    # Docker compose projects (optional detail)
    docker_compose_projects:
      - name: "harbor"
        path: "/opt/harbor"
        # Note: Harbor runs as Docker Compose stack"
      - name: "powerdns"
        path: "/opt/powerdns"
        # Note: PowerDNS recursor/authoritative"

# The legacy nas_dns section is replaced by linux above.
# If you had previously configured nas_dns credentials, they are now
# incorporated into the linux section's services and docker_compose_projects.